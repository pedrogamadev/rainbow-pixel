# Copie para tools/headless-client/.env e preencha. Nunca commite o .env.
# O cliente headless é uma ferramenta de teste: recusa rodar sem DEV_TOOLS=true aqui e
# nunca roda com NODE_ENV=production.

DEV_TOOLS=false
NODE_ENV=development

# Mesmo projeto do Supabase do cliente web: URL e chave publishable (nunca a chave secreta).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Senha das contas de teste dev1 a dev4 (a mesma de DEV_SEED_PASSWORD no servidor).
DEV_SEED_PASSWORD=

# Endereço do WebSocket do servidor de jogo.
SERVER_WS_URL=ws://localhost:2567
