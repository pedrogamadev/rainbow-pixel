{
  "name": "@rainbow-pixel/maps",
  "version": "0.1.0",
  "private": true,
  "description": "Mapas do jogo: formato MapDefinition, schema e mapas gerados pelo importador do Tiled.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./format": {
      "development": "./src/format.ts",
      "types": "./dist/src/format.d.ts",
      "default": "./dist/src/format.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:gym": "tsx scripts/generate-gym.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
