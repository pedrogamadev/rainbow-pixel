# Copie para apps/server/.env e preencha. Nunca commite o .env.

# Porta única do servidor (API REST e WebSocket do Colyseus).
PORT=2567

# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# Banco (Supabase > Connect).
# DATABASE_URL: URL do pooler (Transaction pooler, porta 6543), usada pelo servidor.
# DIRECT_URL: conexão direta (ou Session pooler, porta 5432), usada só pelas migrations.
DATABASE_URL=
DIRECT_URL=

# URL do projeto no Supabase, por exemplo https://abcdefgh.supabase.co
SUPABASE_URL=

# Como validar o JWT do Supabase:
# jwks: chaves de assinatura assimétricas (padrão dos projetos novos).
# secret: segredo legado HS256; exige SUPABASE_JWT_SECRET.
AUTH_JWT_MODE=jwks
SUPABASE_JWT_SECRET=

NODE_ENV=development

# Ferramentas de teste. O servidor não sobe com DEV_TOOLS=true e NODE_ENV=production.
DEV_TOOLS=false

# Usadas só por `pnpm dev:seed-users` (exige DEV_TOOLS=true).
# A chave secreta do Supabase fica somente aqui, nunca no cliente.
SUPABASE_SECRET_KEY=
DEV_SEED_PASSWORD=
