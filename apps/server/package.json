{
  "name": "@rainbow-pixel/server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de jogo (Colyseus) e API REST (Express).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "dev:seed-users": "tsx --conditions=development scripts/seed-dev-users.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.48",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@rainbow-pixel/shared": "workspace:*",
    "colyseus": "^0.18.12",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
