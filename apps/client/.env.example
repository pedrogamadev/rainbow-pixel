# Copie para apps/client/.env e preencha. Nunca commite o .env.
# Tudo que começa com VITE_ vai para o navegador: aqui só entram valores públicos.
# A chave secreta do Supabase (secret ou service_role) nunca entra neste arquivo.

# URL do projeto no Supabase, por exemplo https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Chave publicável do Supabase (publishable ou anon).
VITE_SUPABASE_PUBLISHABLE_KEY=

# Endereço do servidor de jogo. Com Cloudflare Tunnel, use o endereço https do túnel
# em VITE_SERVER_HTTP_URL e o mesmo endereço com wss:// em VITE_SERVER_WS_URL.
VITE_SERVER_HTTP_URL=http://localhost:2567
VITE_SERVER_WS_URL=ws://localhost:2567

# Ferramentas de teste: sessão por aba e botões "Entrar como dev1" a "dev4" no login.
# Só valem em `pnpm dev`; em build de produção ficam sempre desligadas.
VITE_DEV_TOOLS=false

# Opcional, só com VITE_DEV_TOOLS=true: senha das contas de teste (a mesma de
# DEV_SEED_PASSWORD no servidor), usada pelos botões de acesso rápido.
# Sem ela, os botões usam a senha digitada no campo de senha do login.
VITE_DEV_SEED_PASSWORD=
